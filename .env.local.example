NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opsional — alamat kontak operator untuk verifikasi referensi.
# Crossref menempatkan pemanggil yang menyertakan alamat kontak di "polite
# pool" yang lebih cepat dan lebih longgar batas lajunya. Kosongkan saja kalau
# tidak ingin mencantumkannya; verifikasi tetap berjalan tanpa ini.
# Jangan isi dengan email staf/pengguna aplikasi — ini dikirim ke pihak ketiga.
REFERENCE_CHECK_CONTACT_EMAIL=

# Local PostgreSQL with Docker
DATABASE_URL=postgres://admin:adminadmin@127.0.0.1:5432/mqc_db
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string

# OJS Submission Screening Shared Secret Key
MQC_API_SECRET=replace_with_shared_secret_between_ojs_and_mqc

# Local Manuscript File Storage Directory (relative to project root or absolute path)
MANUSCRIPT_STORAGE_DIR=storage/manuscripts

